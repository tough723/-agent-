<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.oncall</groupId>
    <artifactId>oncall-agent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>oncall-tool-gateway</artifactId>
  <name>oncall-tool-gateway</name>

  <!--
    工具网关：所有工具调用的唯一入口。
    本地 @Tool 工具与 MCP 远端工具都收敛成 ToolCallback，再统一套 GuardedToolCallback，
    这样安全策略就与工具来源无关（修复原方案"注解式风险分级对 MCP 工具失效"的 P0 问题）。

    ⚠️ 依赖坐标未经解析验证（当前环境无 Maven / 无外网）：
       ToolCallback / ToolDefinition 在 Spring AI 1.x 属于 org.springframework.ai.tool 包。
       若 spring-ai-model 解析不到，改依赖 spring-ai-alibaba-starter-dashscope（会传递带入工具 API）。
  -->
  <dependencies>
    <dependency>
      <groupId>com.oncall</groupId>
      <artifactId>oncall-domain</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-model</artifactId>
    </dependency>
    <!--
      仅测试作用域：用于校验 oncall-config 里以字符串声明的枚举取值
      （autonomy.level / autonomy.kill-switch-mode）与真实枚举常量一致。
      oncall-config 刻意保持零依赖，所以这条一致性只能从这边守。
    -->
    <dependency>
      <groupId>com.oncall</groupId>
      <artifactId>oncall-config</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
