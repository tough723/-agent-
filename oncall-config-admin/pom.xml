<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.oncall</groupId>
    <artifactId>oncall-agent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>oncall-config-admin</artifactId>
  <name>oncall-config-admin</name>

  <!--
    配置治理的 REST 接入层。

    为什么不直接放进 oncall-config：
      oncall-config 刻意保持生产代码零外部依赖，这样任何模块都能依赖它而不会
      被 Spring 传染。一旦在里面放 @RestController，这条约束就破了——
      而且破得毫无必要，因为 HTTP 绑定本来就该是可替换的适配器。
      所以 REST 层单独成模块，依赖方向是 admin -> config，不反向。

    这一层要解决的不只是"暴露接口"：
      配置写入是一次「操作」而不是一个「设置」。把 autonomy.level 从 SUGGEST
      改到 BOUNDED_AUTO 等价于提权，因此需要审计、边界校验、以及高危项的
      双人复核（见 配置外置与前端可配置设计.md 第三节）。
  -->

  <dependencies>
    <dependency>
      <groupId>com.oncall</groupId>
      <artifactId>oncall-config</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!--
      领域层：Operator 与 TwoPersonReview（双人复核的决策核心）住在这里。
      刻意不在本模块复制一份复核逻辑——工具白名单变更（oncall-tool-gateway）
      走的是同一套规则，两处各写一遍一定会分叉，而分叉不会报错。
      依赖方向 admin -> domain，不反向。
    -->
    <dependency>
      <groupId>com.oncall</groupId>
      <artifactId>oncall-domain</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!--
      只用 starter-web 里的 spring-web / spring-webmvc / jackson。
      不引 spring-boot-starter（自动装配）——本模块只提供 Controller，
      由最终的应用模块决定如何装配，避免在库模块里埋 @SpringBootApplication。
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
