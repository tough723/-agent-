<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.oncall</groupId>
    <artifactId>oncall-agent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>oncall-alert</artifactId>
  <name>oncall-alert</name>
  <!--
    告警接入与聚合。V3__alert.sql 的文件头写着「对应模块 oncall-alert，规划中」，
    这一轮把它建出来：alert_group 与 alert_event 此前写入方都是 0，
    而它们是整条排查链的输入端——没有告警就没有可排查的东西。

    只依赖 oncall-domain（拿 AlertGroup / AlertEvent / AlertSeverity / AlertStatus）。
    刻意不依赖 Spring：本模块只做落库，HTTP 接入属于将来的接入层。
  -->
  <dependencies>
    <dependency>
      <groupId>com.oncall</groupId>
      <artifactId>oncall-domain</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!--
      仅测试作用域：两张告警表都是 PARTITION BY RANGE，
      用 H2 验证等于赌它的方言兼容性。直接连真实 PostgreSQL 才是诚实的验证
      （理由与 JdbcLlmCallLogTest / JdbcAgentRunStoreTest 相同）。
      版本由父 pom 的 spring-boot-dependencies BOM 管。
    -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
