<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.oncall</groupId>
  <artifactId>oncall-agent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>oncall-agent</name>
  <description>智能 OnCall Agent —— 模块化单体 + 2 个可独立伸缩组件</description>

  <!--
    版本基线（ADR-001）

    Spring AI Alibaba 取 GA 线 1.1.2.3；不要用 2.0.0-M1.1（milestone）。
    Spring AI 版本由 SAA BOM 传递，不要手动覆盖。
    开工第一件事请执行并把结果记进 ADR-001：
        mvn dependency:tree -Dincludes=org.springframework.ai

    注意：XML 注释内部不允许出现连续两个减号，所以此处不要写减号分隔线。
  -->
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-boot.version>3.3.5</spring-boot.version>
    <spring-ai-alibaba.version>1.1.2.3</spring-ai-alibaba.version>
    <!--
      spring-ai-bom 1.1.6 发布于 2026-05-09，SAA 1.1.2.3 发布于 2026-05-12，
      时间上最贴近的配对。若 CI 报版本冲突，按 ADR-001 调整此值。
    -->
    <spring-ai.version>1.1.6</spring-ai.version>
    <junit.version>5.10.2</junit.version>
    <assertj.version>3.25.3</assertj.version>
  </properties>

  <modules>
    <module>oncall-domain</module>
    <module>oncall-tool-gateway</module>
  </modules>

  <!--
    关键：Maven 的 super-POM 把 maven-surefire-plugin 默认钉在 2.12.4，
    该版本不支持 JUnit 5 —— 它会「找不到测试」然后静默成功。
    表现就是 CI 全绿但一个测试都没跑（本轮实测 surefire-reports 为空）。
    必须显式升级到支持 JUnit Platform 的版本。
  -->
  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.2.5</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <dependencyManagement>
    <dependencies>
      <!--
        关键：spring-ai-alibaba-bom 只管 com.alibaba.cloud.ai 自己的模块，
        **不**管 org.springframework.ai 的 artifact。只引 SAA BOM 会让
        spring-ai-model 等依赖缺失 version，导致 POM 模型校验失败——
        而且是整个 reactor 失败，连不依赖 Spring AI 的 oncall-domain 都构建不了。
        官方文档（java2ai.com/docs/versions）要求两个 BOM 同时引入。
      -->
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>${spring-ai.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.alibaba.cloud.ai</groupId>
        <artifactId>spring-ai-alibaba-bom</artifactId>
        <version>${spring-ai-alibaba.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- junit-jupiter 是聚合件，理论上已传递 junit-jupiter-engine；
         这里显式再声明引擎与 launcher，避免 surefire 因找不到 JUnit Platform
         引擎而静默报 "No tests to run" 却依然构建成功。 -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
