<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.oncall</groupId>
    <artifactId>oncall-agent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>oncall-agent-core</artifactId>
  <name>oncall-agent-core</name>

  <!--
    AI 编排层。当前只有一件事：把 LLM 调用的可靠性从业务里摘出来。

    为什么先做这一层而不是先做 Planner / IntentClassifier：
      那些都依赖 LLM，而真模型非确定——进了 CI 就是随机红，
      红了没人分得清是逻辑坏了还是模型今天不高兴。
      所以先有 StubChatModel（在 src/test/java），后面每一项才可测。
      这一层是「前置条件」，不是「其中一项」。

    artifactId 用 oncall-agent-core 而不是 oncall-agent：
      父 pom 的 artifactId 已经占了 oncall-agent 这个名字，
      Maven 不允许同一个 groupId 下有两个同 artifactId 的模块。

    刻意只依赖 spring-ai-model，不依赖 oncall-domain / oncall-config：
      重试与 failover 是传输层的可靠性问题，与领域概念无关。
      让它保持零内部依赖，任何模块都能拿它去包装自己的 ChatModel。
      配置项（fallback.model-failover-chain）的读取留给最终的应用模块。

      注意「模块零内部依赖」与「包零内部依赖」是两件事：
      本模块依赖 oncall-config（IntentClassifier 要读配置），
      但 ArchUnit F11 钉住的是 com.oncall.agent.llm 与 com.oncall.agent.prompt
      这两个子包不得依赖任何内部包——基础件必须能被单独复用，
      编排件（com.oncall.agent.query）本来就要读配置。
  -->

  <dependencies>
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-model</artifactId>
    </dependency>

    <!--
      PromptRegistry.fromClasspath 用 PathMatchingResourcePatternResolver 扫
      prompts/*.md。它其实是 spring-ai-model 的传递依赖，但本模块的源码直接
      import 了它，所以显式声明——传递依赖不是契约，上游哪天收敛依赖树，
      这里会在没人改动本模块的情况下编译失败。
      版本由 spring-boot-dependencies BOM 管，不写死。
    -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-core</artifactId>
    </dependency>

    <!--
      IntentClassifier 要读 query.rewrite-enabled 与 query.rewrite-min-confidence，
      而且必须**每次调用都读**——这两个键是 RUNTIME_HOT，构造时读一次就成了假热更新。
      所以这里依赖配置模块本身，而不是让 classifier 收两个裸参数：
      收裸参数的话这两个配置项就没有读取者，改了不生效，
      而「配置项声明了却没人读」是本项目明令禁止的形状。
    -->
    <dependency>
      <groupId>com.oncall</groupId>
      <artifactId>oncall-config</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!--
      解析模型返回的 JSON。它是 spring-ai-model 的传递依赖，但本模块源码直接
      import，所以显式声明——理由同上面的 spring-core。
    -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
  </dependencies>
</project>
